# vim:foldmethod=marker:foldlevel=0

set $mod Mod4
for_window [class="^.*"] border pixel 1

# Font for window titles. Will also be used by the bar unless a different font
# is used in the bar {} block below.
font pango:Hack Nerd Font 12

# Use Mouse+$mod to drag floating windows to their wanted position
floating_modifier $mod

# {{{ background
output * bg $HOME/Pictures/background.png fill
# }}}
# {{{ cursor
seat seat0 xcursor_theme catppuccin-mocha-dark-cursors 24
# }}}
# {{{ bar
bar {
    swaybar_command waybar
}
# }}}
# {{{ idle / lock
exec swayidle -w \
    timeout 300 'swaylock -f' \
    timeout 600 'swaymsg "output * power off"' resume 'swaymsg "output * power on"' \
    before-sleep 'swaylock -f'
# }}}
# {{{ startup
exec /usr/lib/polkit-gnome/polkit-gnome-authentication-agent-1
exec nm-applet
exec xfce4-power-manager
exec blueman-applet
exec wl-paste --type text --watch cliphist store
exec wl-paste --type image --watch cliphist store
exec_always ff-theme-util
# }}}
# {{{ gaps
gaps inner 10
gaps outer 5
# }}}
# {{{ keybinds
# {{{ applications
# application launcher
bindsym $mod+t exec rofi -show window
bindsym $mod+d exec rofi -show drun

# terminal
bindsym $mod+Return exec foot

# take a screenshot of selected region
# x: save to file and copy to clipboard, z: clipboard only (matches hyprland.conf's hyprshot convention)
bindsym --release $mod+x exec grim -g "$(slurp)" - | tee $HOME/Pictures/screenshots/$(date +%Y%m%d_%H%M%S).png | wl-copy
bindsym --release $mod+z exec grim -g "$(slurp)" - | wl-copy

# kill focused window
bindsym $mod+q kill
# }}}
# touchpad {{{
bindsym $mod+Control+q exec swaymsg input type:touchpad events disabled
bindsym $mod+Control+w exec swaymsg input type:touchpad events enabled
# }}}
# {{{ keyboard layout
bindsym $mod+Control+Shift+q exec swaymsg input type:keyboard xkb_layout us
bindsym $mod+Control+Shift+c exec swaymsg input type:keyboard xkb_layout us xkb_variant colemak
# }}}
# {{{ volume
bindsym XF86AudioRaiseVolume exec wpctl set-volume -l 1 @DEFAULT_AUDIO_SINK@ 5%+
bindsym XF86AudioLowerVolume exec wpctl set-volume @DEFAULT_AUDIO_SINK@ 5%-
bindsym XF86AudioMute exec wpctl set-mute @DEFAULT_AUDIO_SINK@ toggle
bindsym $mod+XF86AudioMute exec pavucontrol
# }}}
# {{{ screen brightness
bindsym XF86MonBrightnessUp exec brightnessctl -e4 -n2 set 5%+
bindsym XF86MonBrightnessDown exec brightnessctl -e4 -n2 set 5%-
# }}}
# {{{ media
bindsym XF86AudioNext exec playerctl next
bindsym XF86AudioPause exec playerctl play-pause
bindsym XF86AudioPlay exec playerctl play-pause
bindsym XF86AudioPrev exec playerctl previous
# }}}
# {{{ workspaces
set $workspace1 "1/CODE"
set $workspace2 "2/BROWSE"
set $workspace3 "3/CHAT"
set $workspace4 "4"
set $workspace5 "5"
set $workspace6 "6"
set $workspace7 "7"
set $workspace8 "8"
set $workspace9 "9"
set $workspace10 "0"

bindsym $mod+1 workspace $workspace1
bindsym $mod+2 workspace $workspace2
bindsym $mod+3 workspace $workspace3
bindsym $mod+4 workspace $workspace4
bindsym $mod+5 workspace $workspace5
bindsym $mod+6 workspace $workspace6
bindsym $mod+7 workspace $workspace7
bindsym $mod+8 workspace $workspace8
bindsym $mod+9 workspace $workspace9
bindsym $mod+0 workspace $workspace10

# move focused container to workspace
bindsym $mod+Control+1 move container to workspace $workspace1; workspace $workspace1
bindsym $mod+Control+2 move container to workspace $workspace2; workspace $workspace2
bindsym $mod+Control+3 move container to workspace $workspace3; workspace $workspace3
bindsym $mod+Control+4 move container to workspace $workspace4; workspace $workspace4
bindsym $mod+Control+5 move container to workspace $workspace5; workspace $workspace5
bindsym $mod+Control+6 move container to workspace $workspace6; workspace $workspace6
bindsym $mod+Control+7 move container to workspace $workspace7; workspace $workspace7
bindsym $mod+Control+8 move container to workspace $workspace8; workspace $workspace8
bindsym $mod+Control+9 move container to workspace $workspace9; workspace $workspace9
bindsym $mod+Control+0 move container to workspace $workspace10; workspace $workspace10
# }}}
# {{{ sway control
# reload the configuration file
bindsym $mod+Control+c reload
# restart sway inplace (preserves your layout/session, can be used to upgrade sway)
bindsym $mod+Control+r restart

bindsym $mod+Control+e mode "$sysmenu"
set $sysmenu (m)onitors, (l)ock, (e)xit, (s)uspend, (r)eboot, (Shift+s)hutdown
mode "$sysmenu" {
    bindsym l exec swaylock -f, mode "default"
    bindsym s exec systemctl suspend, mode "default"
    bindsym e exec swaymsg exit, mode "default"
    bindsym r exec systemctl reboot, mode "default"
    bindsym m exec ~/.config/sway/monitors.sh, mode "default"
    bindsym Shift+s exec systemctl poweroff, mode "default"

    # exit system mode: "Enter" or "Escape"
    bindsym Return mode "default"
    bindsym Escape mode "default"
}
# }}}
# {{{ resizing
bindsym $mod+r mode "$resize"
set $resize (j) shrink width, (l) grow width, (k) shrink height, (h) grow height
mode "$resize" {
  bindsym j resize shrink width 10 px or 10 ppt
  bindsym h resize grow height 10 px or 10 ppt
  bindsym k resize shrink height 10 px or 10 ppt
  bindsym l resize grow width 10 px or 10 ppt

  bindsym Return mode "default"
  bindsym Escape mode "default"
}
# }}}
# {{{ window manipulation
set $window_manipulation (f)ullscreen, s(p)lit, (t)abbed, (s)tacked, fl(o)ating
mode "$window_manipulation" {
  bindsym a focus parent
  bindsym z focus child

  bindsym j move down
  bindsym k move up
  bindsym h move left
  bindsym l move right

  bindsym $mod+j focus down
  bindsym $mod+k focus up
  bindsym $mod+h focus left
  bindsym $mod+l focus right

  bindsym o floating toggle
  bindsym f fullscreen toggle
  bindsym p layout toggle split
  bindsym t layout tabbed
  bindsym s layout stacking

  bindsym Return mode "default"
  bindsym Escape mode "default"
}

bindsym $mod+e mode "$window_manipulation"
# }}}
# {{{ change focus
bindsym $mod+j focus down
bindsym $mod+k focus up
bindsym $mod+h focus left
bindsym $mod+l focus right
# }}}
