#!/usr/bin/env bash

TMUX_SPLIT_SIZE=10

if [ -z "$TMUX" ]; then
  echo "Not running inside tmux session."
  exit 1
fi

TMUX_SPLIT_ID=$(tmux show-option -wv @tmux-split-id 2>/dev/null)
CURRENT_PANE_ID=$(tmux display-message -p '#{pane_id}')

if [ -z "$TMUX_SPLIT_ID" ] || ! tmux list-panes | grep -q "$TMUX_SPLIT_ID" || [ "$CURRENT_PANE_ID" = "$TMUX_SPLIT_ID" ]; then
  TMUX_SPLIT_ID=$(tmux split-window -d -v -l $TMUX_SPLIT_SIZE -P -F "#{pane_id}")
  tmux set-option -w @tmux-split-id "$TMUX_SPLIT_ID"

  # Wait for the new shell to draw its prompt, otherwise send-keys is swallowed
  for _ in $(seq 1 100); do
    [ -n "$(tmux capture-pane -p -t "$TMUX_SPLIT_ID" | tr -d '[:space:]')" ] && break
    sleep 0.05
  done
fi

if [ "$(tmux display-message -p '#{window_zoomed_flag}')" = '1' ]; then
  tmux resize-pane -Z -t "$CURRENT_PANE_ID"
fi

tmux send-keys -t "$TMUX_SPLIT_ID" "$* && tmux resize-pane -Z -t $CURRENT_PANE_ID" C-m
