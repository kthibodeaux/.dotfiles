#!/bin/zsh

function use_wt {
  selected=$(cat ~/.dirs | fzf)

  if [[ -z $selected ]]; then
    exit 0
  fi

  selected_name=$(basename "$selected" | tr . _)
  tmux_running=$(pgrep tmux)

  if [[ -z $TMUX ]] && [[ -z $tmux_running ]]; then
    tmux new-session -s $selected_name -c $selected
    exit 0
  fi

  if ! tmux has-session -t=$selected_name 2> /dev/null; then
    tmux new-session -ds $selected_name -c $selected
  fi

  tmux attach -t $selected_name
}

function pair() {
  local session=${1:-pair}
  local attach_flags=$2

  tmux has-session -t $session 2>/dev/null || tmux new -s $session -d || return 1

  # run inside upterm so UPTERM_ADMIN_SOCKET is set and `upterm session current` works
  upterm host --force-command "tmux attach -t $session $attach_flags" -- zsh -c '
    upterm session current \
      | sed "s/\x1b\[[0-9;]*m//g" \
      | grep -m1 -oE "ssh [[:alnum:]_-]+@[^[:space:]]+" \
      | tr -d "\n" \
      | wl-copy
    exec tmux attach -t $1 \; display-message "Copied upterm SSH address to clipboard"
  ' _ $session
}

if [ "$TMUX" = "" ]; then
  tmux ls
  echo ""
  echo "Enter a session number, p for new pair session, r for new pair session (read only), q to not launch tmux, n for a new session"
  echo "Leave blank to use warptmux"
  read "response?[#/p/n/q] "
  case $response in
    [qQ])
      return 1
      ;;
    [pP])
      pair
      ;;
    [rR])
      pair pair-ro -r
      ;;
    *)
      tmux attach -t $response || use_wt
      ;;
  esac
fi
